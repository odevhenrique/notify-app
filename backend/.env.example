# Banco de dados (SQLAlchemy / PostgreSQL)
# Se estiver usando "docker compose up", esta variável é sobrescrita
# automaticamente (aponta para o serviço "db" do docker-compose.yml).
# Só é necessária ao rodar o backend fora do Docker.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/notifyapp

# Autenticação JWT
SECRET_KEY=troque-por-uma-chave-secreta-forte
ALGORITHM=HS256

# Envio de e-mail (Resend - usado para recuperação de senha)
RESEND_API_KEY=
EMAIL_FROM=Notify Home <onboarding@resend.dev>

# Upload de arquivos (Cloudinary - comprovantes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
